APP_NAME=BioMonitor O2T
APP_ENV=development
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=30
DATABASE_URL=sqlite:///./biomonitor.db
COOKIE_SECURE=false

# Datos de demostración. Ponlo en false en un servidor casero real.
SEED_DEMO_DATA=true

# Capacidad: 3-5 ESP32 como máximo y un dispositivo por cuenta.
MAX_DEVICES=5
MAX_DEVICES_PER_USER=1

# Clave compartida que usan los ESP32 para pedir su código de emparejamiento.
DEVICE_PROVISIONING_KEY=cambia-esta-clave-de-provisionamiento
PAIRING_CODE_TTL_MINUTES=10
PAIRING_MAX_ATTEMPTS=10
PAIRING_ATTEMPT_WINDOW_SECONDS=60
